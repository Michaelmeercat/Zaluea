{
  "name": "riftkeepers",
  "version": "1.0.0",
  "private": true,
  "description": "Riftkeepers - a mobile-friendly tower defense game",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "balance": "BALANCE=1 vitest run tests/balance.sim.test.ts --reporter=verbose",
    "waves:dump": "node --experimental-strip-types scripts/dump-waves.ts",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0"
  }
}
